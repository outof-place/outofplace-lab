  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@12.3.1"
